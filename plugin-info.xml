<?xml version="1.0" encoding="UTF-8"?>
<plugin-info>
  <name>Dita2epub</name>
  <description>Modern EPUB3 transformation plugin for DITA-OT 4.3.5 with cover pages and font embedding</description>
  <version>1.0.1</version>
  <author>J. Jeanne</author>
  <license>Apache License 2.0</license>
  <homepage>https://github.com/jyjeanne/dita2epub</homepage>
  <repository>https://github.com/jyjeanne/dita2epub.git</repository>
  <issues>https://github.com/jyjeanne/dita2epub/issues</issues>

  <compatibility>
    <dita-ot-version>4.3.5</dita-ot-version>
    <java-version>17</java-version>
  </compatibility>

  <features>
    <feature>EPUB 3.3 support</feature>
    <feature>WCAG 2.1 accessibility</feature>
    <feature>Modern HTML5 semantic markup</feature>
    <feature>Cover page generation with multiple styles</feature>
    <feature>Font embedding (TTF, OTF, WOFF, WOFF2)</feature>
    <feature>Gradle build integration</feature>
    <feature>Internationalization support</feature>
    <feature>Custom CSS styling</feature>
    <feature>Rich media support</feature>
    <feature>Comprehensive test suite (44 tests)</feature>
  </features>

  <dependencies>
    <dependency plugin="org.dita.base" version="4.3.5"/>
    <dependency plugin="org.dita.html5" version="4.3.5"/>
  </dependencies>

  <release-notes>
    <release version="1.0.1" date="2025-10-29">
      <note>Cover page generation with customizable styles (full-page, centered, custom)</note>
      <note>Font embedding support (TTF, OTF, WOFF, WOFF2)</note>
      <note>Comprehensive test suite with 44 tests across 6 test classes</note>
      <note>GitHub Actions CI/CD automation</note>
      <note>Enhanced documentation with complete parameter reference</note>
      <note>Fixed Windows path handling for cover images</note>
      <note>Improved parameter passing from Ant to XSLT</note>
    </release>
    <release version="1.0.0" date="2025-10-29">
      <note>Initial release</note>
      <note>EPUB3 transformation support</note>
      <note>DITA-OT 4.3.5 compatibility</note>
      <note>Gradle build system integration</note>
      <note>Accessibility features built-in</note>
    </release>
  </release-notes>
</plugin-info>
