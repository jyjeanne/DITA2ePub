<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- EPUB 3.3 conformance edge cases that the other datasets never exercise:
     - topic file names that differ only in case (a/Index, c/Readme, d/readme), and a name that
       matches a generated page (b/index vs. index.xhtml when the index is generated)
     - a file name with a space (My Topic.dita)
     - a remote image (in My Topic.dita)
     - a topichead, which the navigation document cannot list as a heading when epub.toc.depth=1 -->
<map xml:lang="en">
  <title>EPUB conformance edge cases</title>
  <topichead navtitle="Topics with clashing names">
    <topicref href="a/Index.dita"/>
    <topicref href="b/index.dita"/>
    <topicref href="c/Readme.dita"/>
    <topicref href="d/readme.dita"/>
  </topichead>
  <topicref href="My%20Topic.dita"/>
</map>
