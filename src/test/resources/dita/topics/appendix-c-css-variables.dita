<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="appendix-c-css-variables" xml:lang="en">
  <title>CSS Variables Reference</title>
  <shortdesc>Complete reference of CSS custom properties available for theme customization.</shortdesc>
  <body>
    <p>All <indexterm>CSS variables<indexterm>reference</indexterm></indexterm>CSS custom properties are defined on the <codeph>:root</codeph> selector and can be overridden in a custom stylesheet. Override only the variables you need — all others retain their theme defaults.</p>

    <section>
      <title>Typography Variables</title>
      <table id="table-css-typography">
        <title>Typography CSS Variables</title>
        <tgroup cols="3">
          <colspec colname="var" colnum="1" align="left"/>
          <colspec colname="default" colnum="2" align="left"/>
          <colspec colname="desc" colnum="3" align="left"/>
          <thead>
            <row>
              <entry>Variable</entry>
              <entry>Default</entry>
              <entry>Description</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry><codeph>--font-body</codeph></entry>
              <entry>-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif</entry>
              <entry>Body text font stack</entry>
            </row>
            <row>
              <entry><codeph>--font-heading</codeph></entry>
              <entry>inherit</entry>
              <entry>Heading font stack (inherits from body by default)</entry>
            </row>
            <row>
              <entry><codeph>--font-mono</codeph></entry>
              <entry>"Courier New", Courier, monospace</entry>
              <entry>Code and preformatted text font</entry>
            </row>
            <row>
              <entry><codeph>--font-size-base</codeph></entry>
              <entry>16px</entry>
              <entry>Base font size for body text</entry>
            </row>
            <row>
              <entry><codeph>--line-height-base</codeph></entry>
              <entry>1.6</entry>
              <entry>Body text line height</entry>
            </row>
            <row>
              <entry><codeph>--line-height-heading</codeph></entry>
              <entry>1.3</entry>
              <entry>Heading line height</entry>
            </row>
            <row>
              <entry><codeph>--font-weight-heading</codeph></entry>
              <entry>600</entry>
              <entry>Heading font weight</entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

    <section>
