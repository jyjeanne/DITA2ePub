        <title>Color CSS Variables</title>
        <tgroup cols="3">
          <colspec colname="var" colnum="1" align="left"/>
          <colspec colname="default" colnum="2" align="left"/>
          <colspec colname="desc" colnum="3" align="left"/>
          <thead>
            <row>
              <entry>Variable</entry>
              <entry>Default</entry>
              <entry>Description</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry><codeph>--color-text</codeph></entry>
              <entry>#333</entry>
              <entry>Primary text color</entry>
            </row>
            <row>
              <entry><codeph>--color-text-heading</codeph></entry>
              <entry>#222</entry>
              <entry>Heading text color</entry>
            </row>
            <row>
              <entry><codeph>--color-text-muted</codeph></entry>
              <entry>#666</entry>
              <entry>Secondary/muted text color</entry>
            </row>
            <row>
              <entry><codeph>--color-background</codeph></entry>
              <entry>#fff</entry>
              <entry>Page background color</entry>
            </row>
            <row>
              <entry><codeph>--color-link</codeph></entry>
              <entry>#0066cc</entry>
              <entry>Hyperlink color</entry>
            </row>
            <row>
              <entry><codeph>--color-border</codeph></entry>
              <entry>#ddd</entry>
              <entry>Default border color</entry>
            </row>
            <row>
              <entry><codeph>--color-border-heavy</codeph></entry>
              <entry>#bbb</entry>
              <entry>Heavy border color (table frames, separators)</entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>

