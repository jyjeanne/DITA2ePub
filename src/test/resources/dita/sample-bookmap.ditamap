<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "bookmap.dtd">
<bookmap id="sample-bookmap" xml:lang="en">
  <booktitle>
    <mainbooktitle>Sample EPUB Book</mainbooktitle>
    <booktitlealt>A Test Publication for Dita2epub</booktitlealt>
  </booktitle>

  <bookmeta>
    <author>John Doe</author>
    <publisherinformation>
      <organization>Sample Publisher</organization>
    </publisherinformation>
    <keywords>
      <keyword>DITA</keyword>
      <keyword>EPUB3</keyword>
      <keyword>Publishing</keyword>
    </keywords>
    <bookid>
      <isbn>978-0-123456-78-9</isbn>
    </bookid>
    <bookrights>
      <copyrfirst>
        <year>2025</year>
      </copyrfirst>
      <bookowner>
        <organization>Sample Publisher</organization>
      </bookowner>
    </bookrights>
    <data name="series" value="DITA Publishing Guides"/>
    <data name="series-position" value="1"/>
    <data name="bisac" value="COM051360"/>
    <data name="bisac" value="COM060160"/>
  </bookmeta>

  <frontmatter>
    <topicref href="topics/dedication.dita" navtitle="Dedication" type="dedication"/>
    <topicref href="topics/preface.dita" navtitle="Preface"/>
  </frontmatter>

  <chapter href="topics/chapter1.dita" navtitle="Chapter 1: Introduction">
    <topicref href="topics/section1-1.dita" navtitle="1.1 Getting Started"/>
    <topicref href="topics/section1-2.dita" navtitle="1.2 Basic Concepts"/>
  </chapter>

  <chapter href="topics/chapter2.dita" navtitle="Chapter 2: Advanced Topics">
    <topicref href="topics/section2-1.dita" navtitle="2.1 Advanced Features"/>
    <topicref href="topics/section2-2.dita" navtitle="2.2 Best Practices"/>
  </chapter>

  <chapter href="topics/typography-showcase.dita" navtitle="Chapter 3: Typography Showcase"/>

  <backmatter>
    <topicref href="topics/appendix.dita" navtitle="Appendix"/>
    <topicref href="topics/colophon.dita" navtitle="Colophon" type="colophon"/>
    <booklists>
      <glossarylist>
        <topicref href="topics/glossary/glossary-dita.dita" keys="gl-dita"/>
        <topicref href="topics/glossary/glossary-epub.dita" keys="gl-epub"/>
