<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "bookmap.dtd">
<bookmap id="sample-bookmap" xml:lang="en">
  <booktitle>
    <mainbooktitle>The DITA to EPUB Handbook</mainbooktitle>
    <booktitlealt>A Complete Guide to Digital Publishing with DITA2ePub</booktitlealt>
  </booktitle>

  <bookmeta>
    <authorinformation>
      <personinfo>
        <namedetails>
          <personname>
            <firstname>Jeremy</firstname>
            <lastname>Jeanne</lastname>
          </personname>
        </namedetails>
      </personinfo>
    </authorinformation>

    <publisherinformation>
      <organization>Sample Publisher</organization>
      <published>
        <completed>
          <year>2026</year>
          <month>03</month>
          <day>08</day>
        </completed>
      </published>
    </publisherinformation>

    <keywords>
      <keyword>DITA</keyword>
      <keyword>EPUB3</keyword>
      <keyword>Publishing</keyword>
      <keyword>Digital Books</keyword>
      <keyword>Accessibility</keyword>
      <keyword>XSLT</keyword>
    </keywords>

    <bookid>
      <edition>Second Edition</edition>
      <isbn>978-0-13-468599-1</isbn>
    </bookid>

    <bookrights>
      <copyrfirst>
        <year>2025</year>
      </copyrfirst>
      <copyrlast>
        <year>2026</year>
      </copyrlast>
      <bookowner>
        <organization>Sample Publisher</organization>
      </bookowner>
    </bookrights>

    <!-- Series metadata -->
    <data name="series" value="DITA Publishing Guides"/>
    <data name="series-position" value="1"/>

    <!-- BISAC subject codes -->
    <data name="bisac" value="COM051360"/>
    <data name="bisac" value="COM060160"/>

    <!-- Translator (for testing localized title page) -->
    <data name="translator" value="Pierre Dupont"/>
    <data name="translator-url" value="https://example.com/translator"/>

    <!-- License (for testing title page license display) -->
    <data name="license" value="Creative Commons Attribution 4.0"/>
    <data name="license-url" value="https://creativecommons.org/licenses/by/4.0/"/>
  </bookmeta>

