<topic id="simple-tables">
  <title>1.3.1 Simple Tables</title>
  <body>
    <p>Simple tables with basic structure.</p>
    <simpletable>
      <sthead>
        <stentry>Name</stentry>
        <stentry>Value</stentry>
      </sthead>
      <strow>
        <stentry>Item 1</stentry>
        <stentry>100</stentry>
      </strow>
      <strow>
        <stentry>Item 2</stentry>
        <stentry>200</stentry>
      </strow>
    </simpletable>
  </body>
