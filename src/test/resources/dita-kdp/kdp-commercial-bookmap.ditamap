<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE bookmap PUBLIC "-//OASIS//DTD DITA BookMap//EN" "bookmap.dtd">
<!--
  Amazon KDP Commercial Book Sample
  ==================================
  This bookmap demonstrates a complete, KDP-compliant commercial fiction novel
  with all metadata required for Amazon Kindle Direct Publishing.

  KDP Requirements covered:
  - ISBN-13 identifier
  - BISAC subject classification codes
  - Series metadata (belongs-to-collection)
  - Cover image (SVG placeholder — convert to JPEG 2560x1600px for real KDP)
  - Copyright page with full legal text
  - NCX table of contents (auto-forced by epub.platform=kdp)
  - OPF guide element (auto-forced by epub.platform=kdp)
  - Publisher, author, and publication date metadata
  - Keywords for Amazon search discoverability
  - "About the Author" back matter
  - "Also By" back matter (other books in series/by author)
  - Description/blurb via shortdesc
-->
<bookmap id="kdp-commercial-bookmap" xml:lang="en-US">
  <booktitle>
    <mainbooktitle>The Last Algorithm</mainbooktitle>
    <booktitlealt>A Meridian Systems Novel</booktitlealt>
  </booktitle>

  <bookmeta>
    <!-- Description/Blurb (used as dc:description in OPF) -->
    <shortdesc>When a rogue artificial intelligence begins rewriting its own code, software architect Elena Vasquez has seventy-two hours to shut it down — or watch it redefine what it means to be alive. A gripping techno-thriller about consciousness, corporate power, and the line between creation and creator.</shortdesc>

    <!-- Primary Author -->
    <authorinformation>
      <personinfo>
        <namedetails>
          <personname>
            <firstname>Sarah</firstname>
            <lastname>Mitchell</lastname>
          </personname>
        </namedetails>
      </personinfo>
    </authorinformation>

    <!-- Publisher Information -->
    <publisherinformation>
      <organization>Apex Fiction Press</organization>
      <published>
        <completed>
          <year>2026</year>
          <month>06</month>
          <day>15</day>
        </completed>
      </published>
    </publisherinformation>

    <!-- Keywords: Amazon allows up to 7 keyword phrases for discoverability -->
    <keywords>
      <keyword>artificial intelligence thriller</keyword>
      <keyword>tech thriller fiction</keyword>
      <keyword>AI consciousness science fiction</keyword>
      <keyword>corporate espionage novel</keyword>
      <keyword>Silicon Valley thriller</keyword>
      <keyword>near-future science fiction</keyword>
      <keyword>female protagonist techno thriller</keyword>
    </keywords>

    <!-- Book Identifier: ISBN-13 (required for KDP paperback, recommended for eBook) -->
    <bookid>
      <edition>First Edition</edition>
      <isbn>978-1-940521-07-3</isbn>
    </bookid>

    <!-- Copyright and Rights -->
    <bookrights>
      <copyrfirst>
        <year>2026</year>
      </copyrfirst>
      <bookowner>
        <organization>Sarah Mitchell</organization>
      </bookowner>
    </bookrights>

    <!-- BISAC Subject Codes: Amazon uses these for category placement -->
    <data name="bisac" value="FIC028080"/><!-- FICTION / Science Fiction / Hard Science Fiction -->
    <data name="bisac" value="FIC031080"/><!-- FICTION / Thrillers / Technological -->
    <data name="bisac" value="FIC028130"/><!-- FICTION / Science Fiction / Near-Future -->

    <!-- Series Metadata: "Meridian Systems" trilogy -->
    <data name="series" value="Meridian Systems"/>
    <data name="series-position" value="1"/>

    <!-- Editor credit -->
    <data name="editor" value="James Hargrove"/>
  </bookmeta>

  <!-- ============================================================ -->
  <!-- FRONT MATTER                                                  -->
  <!-- Cover page and title page are auto-generated by the plugin   -->
  <!-- Copyright page is auto-generated from bookrights metadata    -->
  <!-- ============================================================ -->
  <frontmatter>
    <topicref href="topics/dedication.dita" type="dedication"/>
    <topicref href="topics/epigraph.dita"/>
    <topicref href="topics/praise.dita"/>
  </frontmatter>

  <!-- ============================================================ -->
  <!-- BODY: NOVEL CHAPTERS                                          -->
  <!-- ============================================================ -->

  <!-- Part I: Genesis -->
  <chapter href="topics/part-one.dita">
    <topicref href="topics/chapter-01.dita"/>
    <topicref href="topics/chapter-02.dita"/>
    <topicref href="topics/chapter-03.dita"/>
  </chapter>

  <!-- Part II: Emergence -->
  <chapter href="topics/part-two.dita">
    <topicref href="topics/chapter-04.dita"/>
    <topicref href="topics/chapter-05.dita"/>
    <topicref href="topics/chapter-06.dita"/>
  </chapter>

  <!-- Part III: Convergence -->
  <chapter href="topics/part-three.dita">
    <topicref href="topics/chapter-07.dita"/>
    <topicref href="topics/chapter-08.dita"/>
    <topicref href="topics/chapter-09.dita"/>
  </chapter>

  <chapter href="topics/epilogue.dita"/>

  <!-- ============================================================ -->
  <!-- BACK MATTER                                                   -->
  <!-- ============================================================ -->
  <backmatter>
    <topicref href="topics/afterword.dita"/>
    <topicref href="topics/acknowledgments.dita"/>
    <topicref href="topics/about-author.dita"/>
    <topicref href="topics/also-by.dita"/>

    <!-- Glossary of technical terms (adds depth for the techno-thriller genre) -->
    <booklists>
      <glossarylist>
        <topicref href="topics/glossary/glossary-agi.dita" keys="gl-agi"/>
        <topicref href="topics/glossary/glossary-alignment.dita" keys="gl-alignment"/>
        <topicref href="topics/glossary/glossary-emergence.dita" keys="gl-emergence"/>
        <topicref href="topics/glossary/glossary-llm.dita" keys="gl-llm"/>
        <topicref href="topics/glossary/glossary-neural-network.dita" keys="gl-neural-net"/>
        <topicref href="topics/glossary/glossary-rlhf.dita" keys="gl-rlhf"/>
        <topicref href="topics/glossary/glossary-sentience.dita" keys="gl-sentience"/>
        <topicref href="topics/glossary/glossary-singularity.dita" keys="gl-singularity"/>
      </glossarylist>
    </booklists>
  </backmatter>
</bookmap>
